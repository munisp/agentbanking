{
  "uid": "platform-otel-overview",
  "title": "Platform OTel Overview",
  "tags": ["otel", "platform", "pos54"],
  "timezone": "browser",
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Service error rate (spanmetrics)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (rate({__name__=~\"pos54_calls_total|calls_total\", status_code=\"STATUS_CODE_ERROR\"}[5m])) / sum by (service_name) (rate({__name__=~\"pos54_calls_total|calls_total\"}[5m]))",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "p95 latency by service (ms)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "ms", "min": 0}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (service_name, le) (rate({__name__=~\"pos54_duration_milliseconds_bucket|duration_milliseconds_bucket\"}[5m])))",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Component up status",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {"1": {"text": "UP", "color": "green"}, "0": {"text": "DOWN", "color": "red"}}}
          ]
        },
        "overrides": []
      },
      "options": {"colorMode": "background", "graphMode": "none", "textMode": "value_and_name"},
      "targets": [
        {
          "refId": "A",
          "expr": "max by (job, instance) ({__name__=~\"pos54_up|up\"})",
          "legendFormat": "{{job}} / {{instance}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Collector throughput (spans + metric points /s)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(otelcol_receiver_accepted_spans_total[5m]))",
          "legendFormat": "spans accepted"
        },
        {
          "refId": "B",
          "expr": "sum(rate(otelcol_receiver_accepted_metric_points_total[5m]))",
          "legendFormat": "metric points accepted"
        }
      ]
    }
  ]
}
