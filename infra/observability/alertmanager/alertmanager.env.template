# =============================================================================
# alertmanager.env.template — Round-5 deploy-time secrets for Alertmanager
#
# Copy to alertmanager.env (gitignored) or inject via your secret manager.
# NEVER commit real values. The alertmanager.yml placeholders reference these
# exact variable names (${VAR:-default} substitution happens at deploy time).
#
# Rotation guidance: rotate NTFY tokens and SMTP password on any suspected
# exposure; see docs/observability/deploy-runbook.md section "Rotating secrets".
# =============================================================================

# --- SMTP (email receiver fallback) ---
SMTP_FROM=alertmanager@your-domain.example
SMTP_SMARTHOST=smtp.your-provider.example:587
SMTP_AUTH_USERNAME=
SMTP_AUTH_PASSWORD=

# --- ntfy (self-hosted push) ---
# One token per topic; topics are defined in docker-compose.observability.yml
# (ntfy service). Create tokens with: ntfy token add <user>
NTFY_TOKEN_CRITICAL=
NTFY_TOKEN_FUNDS=
NTFY_TOKEN_OPS=

# --- Ops automation webhook (e.g. incident bridge / chat-ops) ---
OPS_WEBHOOK_URL=https://your-chatops.example/hooks/observability
OPS_WEBHOOK_TOKEN=
